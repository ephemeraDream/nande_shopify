    "custom_liquid_xHtRYB": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Black Friday Staffelrabatte & Angebote</title>\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;700;900&display=swap');\n    \n    body {\n      margin: 0;\n      padding: 0;\n      font-family: 'Poppins', Arial, sans-serif;\n      background: #000000;\n    }\n\n    .coupon-section {\n      background-color: #000000;\n      color: #ffffff;\n      padding: 60px 20px;\n      text-align: center;\n    }\n\n    .coupon-section h2 {\n      font-size: 42px;\n      font-weight: 700;\n      margin-bottom: 20px;\n      color: #ffffff;\n    }\n\n    .coupon-section > p {\n      font-size: 18px;\n      margin-bottom: 30px;\n      color: #cccccc;\n    }\n    \n    /* 统一的按钮风格：黑金主题（金色边框与悬停、黑色底） */\n    .shop-now-btn {\n      display: inline-block;\n      background-color: #000000;\n      color: #ffc857;\n      border: 2px solid #ffc857;\n      padding: 12px 30px;\n      border-radius: 6px;\n      font-weight: bold;\n      font-size: 16px;\n      text-decoration: none;\n      transition: all 0.3s ease;\n      margin-bottom: 50px;\n    }\n    .shop-now-btn:hover {\n      background-color: #ffc857;\n      color: #000000;\n    }\n\n    .coupon-cards {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: center;\n      max-width: 1400px;\n      margin: 0 auto;\n      gap: 30px;\n    }\n\n    .coupon-card {\n      /* 统一黑五暗黑玻璃拟物卡片 */\n      background-color: rgba(20, 20, 20, 0.7);\n      backdrop-filter: blur(10px);\n      -webkit-backdrop-filter: blur(10px);\n      border: 1px solid rgba(255, 200, 87, 0.25);\n      padding: 40px 30px;\n      border-radius: 16px;\n      width: calc(25% - 23px);\n      min-width: 280px;\n      box-sizing: border-box;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), 0 0 15px rgba(255, 200, 87, 0.08);\n      transition: transform 0.3s ease, box-shadow 0.3s ease;\n      min-height: 300px;\n    }\n\n    .coupon-card:hover {\n      transform: translateY(-8px) scale(1.02);\n      border-color: #ffc857;\n      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.8), 0 0 25px rgba(255, 200, 87, 0.2);\n    }\n\n    .coupon-card h3 {\n      font-size: 64px;\n      font-weight: 900;\n      margin: 0;\n      line-height: 1.1;\n      /* 金色渐变文字，突出黑五尊贵感 */\n      background: linear-gradient(180deg, #f0e6d2 0%, #c89b3c 100%);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      background-clip: text;\n      text-fill-color: transparent;\n      text-shadow: 0px 2px 4px rgba(0, 0, 0, 0.3);\n    }\n    \n    .coupon-card p {\n      font-size: 18px;\n      color: #cccccc;\n      margin: 10px 0 0 0;\n    }\n\n    .coupon-footer {\n      margin-top: 30px;\n      padding-top: 20px;\n      border-top: 1px solid rgba(255, 255, 255, 0.1);\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      width: 100%;\n    }\n    \n    .coupon-footer.center {\n        justify-content: center;\n    }\n\n    .coupon-code {\n      color: #ffffff;\n      font-weight: bold;\n      font-size: 18px;\n      letter-spacing: 1px;\n    }\n\n    .copy-btn,\n    .inquiry-btn {\n      padding: 10px 18px;\n      border-radius: 6px;\n      cursor: pointer;\n      font-weight: bold;\n      font-size: 14px;\n      white-space: nowrap;\n      transition: all 0.3s ease;\n      text-decoration: none;\n      display: inline-block;\n    }\n\n    /* 复制按钮 - 初始黑五简约线框 */\n    .copy-btn {\n      background-color: transparent;\n      color: #ffffff;\n      border: 1px solid rgba(255, 255, 255, 0.5);\n    }\n    .copy-btn:hover {\n      background-color: #ffffff;\n      color: #000000;\n      border-color: #ffffff;\n    }\n    .copy-btn.copied {\n      background-color: #ffc857; \n      color: #000000; \n      border-color: #ffc857;\n    }\n\n    /* 复制成功后的“去购买”按钮状态 */\n    .copy-btn.go-to-shop {\n      background-color: #ffc857;\n      color: #000000;\n      border-color: #ffc857;\n    }\n    .copy-btn.go-to-shop:hover {\n      background-color: #e0ac42;\n      border-color: #e0ac42;\n    }\n\n    /* 询价按钮 - 呼应主题的高级亮色样式 */\n    .inquiry-btn {\n      background-color: #ffc857;\n      color: #000000;\n      border: 1px solid #ffc857;\n      width: 100%;\n      text-align: center;\n    }\n    .inquiry-btn:hover {\n      background-color: #e0ac42;\n      border-color: #e0ac42;\n    }\n\n    @media (max-width: 1200px) {\n        .coupon-card {\n            width: calc(50% - 15px);\n        }\n    }\n    @media (max-width: 600px) {\n        .coupon-card {\n            width: 100%;\n        }\n    }\n\n    /* 弹窗样式 */\n    .modal {\n      display: none;\n      position: fixed;\n      z-index: 9999;\n      left: 0;\n      top: 0;\n      width: 100%;\n      height: 100%;\n      overflow: auto;\n      background-color: rgba(0, 0, 0, 0.8);\n      backdrop-filter: blur(5px);\n    }\n    .modal-content {\n      position: relative;\n      background-color: #121212;\n      color: #fff;\n      margin: 10% auto;\n      padding: 30px 40px;\n      border-radius: 12px;\n      width: 90%;\n      max-width: 500px;\n      text-align: left;\n      box-sizing: border-box;\n      border: 1px solid rgba(255, 200, 87, 0.3);\n    }\n    .modal-content h3 {\n      font-size: 22px;\n      margin-bottom: 20px;\n      text-align: center;\n      color: #ffc857;\n    }\n    .modal-content label {\n      font-weight: bold;\n      display: block;\n      margin-bottom: 6px;\n      color: #ccc;\n    }\n    .modal-content textarea {\n      width: 100%;\n      padding: 12px;\n      margin-bottom: 20px;\n      border-radius: 6px;\n      border: 1px solid #444;\n      font-size: 16px;\n      box-sizing: border-box;\n      resize: vertical;\n      background-color: #1a1a1a;\n      color: #fff;\n    }\n    .modal-btns {\n      display: flex;\n      justify-content: flex-end;\n    }\n    .modal-btns button {\n      background-color: #ffc857;\n      color: #000;\n      border: none;\n      padding: 10px 20px;\n      border-radius: 6px;\n      font-weight: bold;\n      cursor: pointer;\n      font-size: 14px;\n      transition: background-color 0.3s ease;\n    }\n    .modal-btns button:hover {\n      background-color: #e0ac42;\n    }\n    .close-btn {\n      position: absolute;\n      top: 16px;\n      right: 16px;\n      background: transparent;\n      color: #aaa;\n      font-size: 28px;\n      border: none;\n      cursor: pointer;\n      font-weight: bold;\n      line-height: 1;\n    }\n    .close-btn:hover {\n      color: #fff;\n    }\n  </style>\n</head>\n<body>\n\n<div class=\"coupon-section\" id=\"coupon-section\">\n  <h2>Mehr kaufen, mehr sparen</h2>\n  <p>Code kopieren und sofort Rabatt sichern oder individuelles Angebot anfragen</p>\n  \n  <a href=\"https://www.maidesite.de/collections/hohenverstellbarer-schreibtisch\" class=\"shop-now-btn\">Jetzt einkaufen</a>\n\n  <div class=\"coupon-cards\">\n    <div class=\"coupon-card\">\n      <div>\n        <h3>40 €</h3>\n        <p>ab 499 € Einkaufswert</p>\n      </div>\n      <div class=\"coupon-footer\">\n        <span class=\"coupon-code\" id=\"code1\">MD40</span>\n        <button class=\"copy-btn\" type=\"button\">Kopieren</button>\n      </div>\n    </div>\n    \n    <div class=\"coupon-card\">\n      <div>\n        <h3>120 €</h3>\n        <p>ab 999 € Einkaufswert</p>\n      </div>\n      <div class=\"coupon-footer\">\n        <span class=\"coupon-code\" id=\"code2\">MD120</span>\n        <button class=\"copy-btn\" type=\"button\">Kopieren</button>\n      </div>\n    </div>\n    \n    <div class=\"coupon-card\">\n      <div>\n        <h3>250 €</h3>\n        <p>ab 1999 € Einkaufswert</p>\n      </div>\n      <div class=\"coupon-footer\">\n        <span class=\"coupon-code\" id=\"code3\">MD250</span>\n        <button class=\"copy-btn\" type=\"button\">Kopieren</button>\n      </div>\n    </div>\n\n    <div class=\"coupon-card inquiry-card\">\n      <div>\n        <h3>Wow</h3>\n        <p>ab 2999 € Einkaufswert</p>\n      </div>\n      <div class=\"coupon-footer center\">\n        <button class=\"inquiry-btn\" type=\"button\">Jetzt Angebot anfragen</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div id=\"contactModal\" class=\"modal\" aria-hidden=\"true\" role=\"dialog\" aria-modal=\"true\">\n  <div class=\"modal-content\" role=\"document\" tabindex=\"-1\">\n    <button type=\"button\" id=\"closeModalBtn\" class=\"close-btn\" aria-label=\"Schließen\">×</button>\n    <h3>Individuelles Rabattangebot anfragen</h3>\n\n    <label for=\"message\">Ihre Anfrage</label>\n    <textarea id=\"message\" name=\"message\" rows=\"5\" placeholder=\"Ihre Anfrage hier eingeben...\" required></textarea>\n\n    <div class=\"modal-btns\">\n      <button type=\"button\" id=\"sendBtn\">Senden</button>\n    </div>\n  </div>\n</div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", () => {\n    document.querySelectorAll('.copy-btn').forEach(button => {\n      button.addEventListener('click', () => {\n        if (button.classList.contains('go-to-shop')) {\n            window.location.href = 'https://www.maidesite.de/collections/hohenverstellbarer-schreibtisch';\n            return;\n        }\n\n        if (button.classList.contains('copied')) {\n            return;\n        }\n\n        const codeSpan = button.previousElementSibling;\n        if (codeSpan) {\n          const code = codeSpan.innerText;\n          navigator.clipboard.writeText(code).then(() => {\n            button.classList.add('copied');\n            button.innerText = '✔ Kopiert';\n            \n            setTimeout(() => {\n              button.classList.remove('copied');\n              button.classList.add('go-to-shop');\n              button.innerText = 'Jetzt kaufen';\n            }, 2000);\n          }).catch(err => {\n            console.error('Failed to copy: ', err);\n          });\n        }\n      });\n    });\n\n    const openBtn = document.querySelector(\".inquiry-btn\");\n    const modal = document.getElementById(\"contactModal\");\n    const closeBtn = document.getElementById(\"closeModalBtn\");\n    const sendBtn = document.getElementById(\"sendBtn\");\n    \n    if (openBtn && modal && closeBtn && sendBtn) {\n        function openModal() {\n            modal.style.display = \"block\";\n            document.body.style.overflow = \"hidden\";\n            modal.setAttribute(\"aria-hidden\", \"false\");\n            modal.querySelector(\".modal-content\").focus();\n        }\n\n        function closeModal() {\n            modal.style.display = \"none\";\n            document.body.style.overflow = \"\";\n            modal.setAttribute(\"aria-hidden\", \"true\");\n        }\n\n        openBtn.addEventListener(\"click\", openModal);\n        closeBtn.addEventListener(\"click\", closeModal);\n        \n        modal.addEventListener(\"click\", (e) => {\n            if (e.target === modal) closeModal();\n        });\n        \n        sendBtn.addEventListener(\"click\", () => {\n            const message = document.getElementById(\"message\").value.trim();\n            if (!message) {\n                alert(\"Bitte geben Sie Ihre Anfrage ein.\");\n                return;\n            }\n\n            const subject = encodeURIComponent(\"Anfrage zu individuellem Rabatt\");\n            const body = encodeURIComponent(message);\n\n            window.location.href = `mailto:contact@maidesite.de?subject=${subject}&body=${body}`;\n            closeModal();\n        });\n    }\n  });\n</script>\n\n</body>\n</html>",
