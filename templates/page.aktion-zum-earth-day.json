        "custom_liquid": "{% comment %}\n    Black Friday Pre-Order & Video Module for Rainbow\n{% endcomment %}\n\n<div class=\"bf-wrapper\" id=\"space-promotion\">\n<div class=\"bf-promo-section\">\n    <div class=\"bf-promo-header\">\n        <h1>Rainbow: Smart RGB-Tisch-Neuheit mit Black Friday Vorteilen</h1>\n        <p>Jetzt anmelden und deinen exklusiven Rabattcode für den neuen Rainbow sichern!</p>\n    </div>\n\n    <div class=\"bf-promo-main-container\">\n        \n        <div class=\"bf-promo-left-panel\">\n          \n            <h2>Vorteilscode für Rainbow sichern</h2>\n            <p>Jetzt mitmachen und den besten Rainbow-Preis sichern!</p>\n            \n\n            <div class=\"price-timeline\">\n                \n                <div class=\"timeline-item active-period\">\n                    <p class=\"date\">12. NOV. – 19. NOV.</p>\n                    <div class=\"price-box\">\n                        <span class=\"emoji\">😊</span>\n                        <p>Jetzt teilnehmen und Code sichern</p>\n                        <strong>Ab 239,99 €</strong>\n                    </div>\n                </div>                \n            </div>\n\n            <div class=\"email-signup-form-wrapper\">\n                <div class=\"input-group\">\n                    <a href=\"https://www.maidesite.de/products/maidesite-rainbow-smart-hohenverstellbarer-tisch-mit-rgb-lichtleiste\" class=\"signup-button open-omnisend-popup\" style=\"width: 100%; box-sizing: border-box; display: inline-block; text-decoration: none;\">\n                        Jetzt mitmachen\n                    </a>\n                </div>\n            </div>\n            \n        </div>\n\n        <div class=\"bf-promo-right-panel\">\n            <div class=\"video-container\">\n                <iframe \n                    src=\"https://www.youtube.com/embed/4760WkCspO4?si=liMXbTKPcfgA812O\"\n                    frameborder=\"0\" \n                    allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" \n                    allowfullscreen\n                    class=\"embedded-video\"\n                ></iframe>\n            </div>\n\n            <div class=\"product-info-bar\">\n                <div class=\"product-details\">\n                    <h3>Rainbow <span class=\"price-badge\">ab 239,99€</span></h3>\n                    <p>Höhenverstellbarer Smart Tisch mit RGB-Lichtleiste</p>\n                </div>\n                \n                <a href=\"https://www.maidesite.de/products/maidesite-rainbow-smart-hohenverstellbarer-tisch-mit-rgb-lichtleiste#looxReviewsFrame\" class=\"learn-more-button\">\n                    Jetzt einkaufen\n                </a>\n            </div>\n\n        </div>\n    </div>\n</div>\n</div>\n\n<style>\n    body, .page-width, .shopify-section {\n        background-color: #000000 !important;\n    }\n\n    .bf-wrapper {\n        width: 100%;\n        background-color: #000000 !important;\n        padding: 40px 0;\n    }\n\n    /* 主模块：使用统一的黑金边框与纯黑背景，契合店铺画廊的高级暗色感 */\n    .bf-promo-section {\n        font-family: Arial, sans-serif;\n        color: #fff;\n        background-color: #000000;\n        padding: 40px 20px;\n        border-radius: 12px;\n        max-width: 1200px;\n        margin: 0 auto;\n        border: 2px solid #ffc857;\n        box-shadow: 0 0 25px rgba(255, 200, 87, 0.2);\n    }\n\n    .bf-promo-header {\n        text-align: center;\n        margin-bottom: 30px;\n    }\n    .bf-promo-header h1 {\n        color: #ffc857;\n        font-size: 2.5em;\n    }\n    .bf-promo-header p {\n        color: #cccccc;\n    }\n\n    .bf-promo-main-container {\n        display: flex;\n        gap: 30px;\n        align-items: stretch !important;\n    }\n\n    /* 左侧面板：去掉了原先突兀的浅黄色渐变，改为与整体和谐的暗色微透背景搭配金边 */\n    .bf-promo-left-panel {\n        flex: 1;\n        background-color: rgba(20, 20, 20, 0.7);\n        border: 1px solid rgba(255, 200, 87, 0.3);\n        padding: 30px;\n        border-radius: 10px;\n    }\n    .bf-promo-left-panel h2 {\n        color: #ffc857;\n        margin-top: 0;\n    }\n    .bf-promo-left-panel p {\n        color: #cccccc;\n    }\n\n    .bf-promo-right-panel {\n        flex: 1;\n        display: flex;\n        flex-direction: column;\n        justify-content: flex-start;\n    }\n\n    .video-container {\n        position: relative;\n        width: 100%;\n        padding-bottom: 56.25%;\n        height: 0;\n        background: #000;\n        margin-bottom: auto;\n        border-radius: 8px;\n        overflow: hidden;\n        border: 1px solid rgba(255, 255, 255, 0.1);\n    }\n    .embedded-video {\n        position: absolute;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 100%;\n    }\n\n    /* 底部条调整为深色质感，让整体无违和感 */\n    .product-info-bar {\n        margin-top: 20px !important;\n        background: rgba(20, 20, 20, 0.9);\n        border: 1px solid rgba(255, 255, 255, 0.15);\n        padding: 15px 20px;\n        border-radius: 8px;\n        color: #ffffff;\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n    }\n    .product-details h3 {\n        margin: 0 0 5px 0;\n        color: #ffffff;\n    }\n    .product-details p {\n        margin: 0;\n        color: #aaaaaa;\n        font-size: 0.9em;\n    }\n\n    .price-badge {\n        background-color: #ffc857;\n        color: #000000;\n        padding: 3px 8px;\n        border-radius: 4px;\n        font-size: 0.75em;\n        margin-left: 10px;\n        font-weight: bold;\n    }\n\n    .learn-more-button {\n        background-color: #ffc857;\n        color: #000000;\n        padding: 10px 20px;\n        border-radius: 6px;\n        text-decoration: none;\n        font-weight: bold;\n        transition: background 0.3s ease;\n    }\n    .learn-more-button:hover {\n        background-color: #e0ac42;\n    }\n\n    .timeline-item {\n        margin-bottom: 15px;\n    }\n    .timeline-item .date {\n 